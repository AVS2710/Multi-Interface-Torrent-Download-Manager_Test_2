{
  "appId": "io.github.avs2710.multitorrent",
  "productName": "MultiTorrent",
  "artifactName": "MultiTorrent-${version}-${arch}.${ext}",
  "directories": {
    "output": "release"
  },
  "files": [
    "dist/**/*",
    "package.json"
  ],
  "asar": true,
  "asarUnpack": [
    "**/*.node"
  ],
  "npmRebuild": true,
  "linux": {
    "target": [
      "AppImage"
    ],
    "icon": "build/icons/",
    "category": "Network",
    "synopsis": "Multi-interface BitTorrent client",
    "description": "A desktop BitTorrent client with configurable outgoing network interfaces."
  },
  "win": {
    "target": [
      {
        "target": "nsis",
        "arch": [
          "x64"
        ]
      }
    ]
  },
  "nsis": {
    "oneClick": false,
    "perMachine": false,
    "allowToChangeInstallationDirectory": true,
    "createDesktopShortcut": true,
    "createStartMenuShortcut": true
  }
}
