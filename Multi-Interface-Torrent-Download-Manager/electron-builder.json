{
  "appId": "com.avs2710.multitorrent",
  "productName": "MultiTorrent",
  "artifactName": "MultiTorrent-${version}-${arch}.${ext}",
  "directories": {
    "output": "release",
    "buildResources": "build"
  },
  "files": [
    "dist/**/*",
    "package.json"
  ],
  "asar": true,
  "asarUnpack": [
    "**/*.node",
    "**/*.so",
    "**/*.so.*"
  ],
  "linux": {
    "target": ["AppImage"],
    "category": "Network",
    "icon": "build/icons",
    "mimeTypes": [
      "application/x-bittorrent",
      "x-scheme-handler/magnet"
    ],
    "synopsis": "BitTorrent downloads with network-interface selection",
    "description": "A desktop BitTorrent client for managing downloads and network interfaces."
  }
}
