{
  "dependencies": {
    "@porla/libtorrent": "^1.0.0-rc.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/sqlite3": "^3.1.11",
    "@weejewel/libtorrent": "^1.2.0",
    "create-torrent": "^6.1.3",
    "electron": "^44.5.1",
    "electron-builder": "^26.15.3",
    "lucide-react": "^1.52.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "sqlite": "^5.1.1",
    "sqlite3": "^6.0.1",
    "vite": "^8.3.2"
  },
  "name": "app",
  "version": "1.0.0",
  "description": "A Linux desktop BitTorrent client with multi-interface network configuration",
  "main": "dist/main/main/main.js",
  "scripts": {
    "clean": "rimraf dist",
    "build:renderer": "vite build",
    "build:main": "tsc -p tsconfig.node.json",
    "build:preload": "vite build --config vite.preload.config.ts",
    "build": "npm run clean && npm run build:renderer && npm run build:main && npm run build:preload",
    "start": "electron .",
    "package:linux": "npm run build && electron-builder --linux AppImage",
    "package": "npm run build && electron-builder",
    "test": "npm run typecheck && npm run lint && npm run test:unit && npm run test:integration",
    "lint": "eslint .",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.node.json --noEmit && tsc -p tsconfig.preload.json --noEmit",
    "test:unit": "vitest run tests/unit",
    "test:integration": "vitest run tests/integration",
    "test:e2e": "playwright test"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/AVS2710/Multi-Interface-Torrent-Download-Manager.git"
  },
  "keywords": ["electron", "bittorrent", "networking"],
  "author": "AVS2710",
  "license": "ISC",
  "type": "module",
  "bugs": {
    "url": "https://github.com/AVS2710/Multi-Interface-Torrent-Download-Manager/issues"
  },
  "homepage": "https://github.com/AVS2710/Multi-Interface-Torrent-Download-Manager#readme",
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.63.0",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@types/jest": "^30.0.0",
    "@typescript-eslint/eslint-plugin": "^8.71.0",
    "@typescript-eslint/parser": "^8.71.0",
    "@vitejs/plugin-react": "^6.1.1",
    "autoprefixer": "^10.4.17",
    "concurrently": "^10.0.5",
    "eslint": "^10.11.0",
    "jsdom": "^29.1.1",
    "playwright": "^1.63.0",
    "postcss": "^8.4.35",
    "rimraf": "^6.1.3",
    "tailwindcss": "^3.4.1",
    "ts-node": "^10.9.2",
    "typescript": "^5.6.2",
    "typescript-eslint": "^8.71.0",
    "vitest": "^5.0.3"
  }
}
