{
  "dependencies": {
    "@porla/libtorrent": "^1.0.0-rc.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/sqlite3": "^3.1.11",
    "@weejewel/libtorrent": "^1.2.0",
    "create-torrent": "^6.1.3",
    "electron": "^44.5.1",
    "electron-builder": "^26.15.3",
    "lucide-react": "^1.52.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "sqlite": "^5.1.1",
    "sqlite3": "^6.0.1",
    "vite": "^8.3.2"
  },
  "name": "app",
  "version": "1.0.0",
  "description": "MultiTorrent is a Linux desktop BitTorrent client with network-interface selection.",
  "main": "dist/main/main/main.js",
  "scripts": {
    "prebuild": "node scripts/generate-icon.mjs",
    "build": "rimraf dist && vite build && tsc -p tsconfig.node.json && vite build --config vite.preload.config.ts",
    "start": "electron .",
    "dist:linux": "npm run build && electron-builder install-app-deps && electron-builder --linux AppImage",
    "package:linux": "npm run dist:linux",
    "lint": "eslint .",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.node.json --noEmit && tsc -p tsconfig.preload.json --noEmit",
    "test": "npm run test:unit && npm run test:integration",
    "test:unit": "vitest run tests/unit",
    "test:integration": "vitest run tests/integration",
    "test:e2e": "playwright test"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/AVS2710/Multi-Interface-Torrent-Download-Manager.git"
  },
  "keywords": ["electron", "bittorrent", "networking", "linux"],
  "author": "AVS2710",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/AVS2710/Multi-Interface-Torrent-Download-Manager/issues"
  },
  "homepage": "https://github.com/AVS2710/Multi-Interface-Torrent-Download-Manager#readme",
  "type": "module",
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.63.0",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@types/jest": "^30.0.0",
    "@typescript-eslint/eslint-plugin": "^8.71.0",
    "@typescript-eslint/parser": "^8.71.0",
    "@vitejs/plugin-react": "^6.1.1",
    "autoprefixer": "^10.4.17",
    "concurrently": "^10.0.5",
    "eslint": "^10.11.0",
    "jsdom": "^29.1.1",
    "playwright": "^1.63.0",
    "rimraf": "^6.1.3",
    "tailwindcss": "^3.4.1",
    "ts-node": "^10.9.2",
    "typescript": "^5.6.2",
    "typescript-eslint": "^8.71.0",
    "vitest": "^5.0.3"
  }
}
